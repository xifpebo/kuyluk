# Stroy Bazar — environment configuration
# Copy with `npm run setup` (generates APP_SECRET) or `cp .env.example .env`.

# ---------------------------------------------------------------- server
NODE_ENV=production
PORT=5000
HOST=0.0.0.0
# Public URL of the site. Use https:// in production (enables Secure cookies + HSTS).
APP_ORIGIN=https://www.stroybazar.com
# Extra origins allowed to send state-changing requests (comma separated). Usually empty.
ALLOWED_ORIGINS=https://stroybazar.com
# Reverse proxy: number of trusted hops (e.g. 1 behind nginx) or a list of proxy IPs.
TRUST_PROXY=
LOG_LEVEL=info

# -------------------------------------------------------------- database
MONGODB_URI=mongodb://127.0.0.1:27017/stroy-bazar

# -------------------------------------------------------------- security
# At least 32 random characters. Signs CSRF tokens. `npm run setup` fills it in.
APP_SECRET=
# auto = Secure cookies when APP_ORIGIN is https
COOKIE_SECURE=auto
# Only for local production-mode testing over plain http. Never enable on a real server.
ALLOW_INSECURE_COOKIES=false

SESSION_IDLE_MINUTES_STAFF=30
SESSION_ABSOLUTE_HOURS_STAFF=12
SESSION_IDLE_HOURS_SELLER=8
SESSION_ABSOLUTE_DAYS_SELLER=7
SESSION_IDLE_DAYS_USER=14
SESSION_ABSOLUTE_DAYS_USER=30

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_HISTORY=5

# mongo (shared between instances) or memory (single process / tests)
RATE_LIMIT_STORE=mongo
# Ignored in production.
RATE_LIMIT_DISABLED=false

# Days to keep admin activity log entries (0 = keep forever).
AUDIT_RETENTION_DAYS=365

# --------------------------------------------------------------- content
SITE_NAME=Stroy Bazar
# Public contacts of the marketplace (header, footer, contact page). They are
# defaults: a super-admin can change them later in Admin → Homepage & settings.
OWNER_NAME=Alisherbek Bobokulov
SUPPORT_PHONE=+998 90 098 00 23
# Usernames without @
SUPPORT_TELEGRAM=iafys
SUPPORT_INSTAGRAM=xifpebo
# uz (default) or ru
DEFAULT_LANG=uz
# google | system | local (self-hosted files in public/fonts, see public/fonts/README.md)
FONT_PROVIDER=local

# First start on an EMPTY database loads the demo marketplace (12 fictional
# shops, 135 products, reviews, banners). Set to false for a clean start.
SEED_DEMO_DATA=true
# Demo admin / shop-owner / customer accounts with the test passwords from the
# README. Default: on in development, off in production (enabling it in
# production prints a warning — delete those accounts before going live).
SEED_DEMO_ACCOUNTS=

UPLOAD_DIR=uploads
UPLOAD_MAX_MB=5

# Optional: notify a Telegram chat about new shop applications and products
# waiting for moderation. The token stays on the server.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# First super-admin: on start-up the server creates this account (or repairs
# its password/role/lockout if it does not match). Useful on hosts without a
# shell such as Render's free plan. Remove ADMIN_PASSWORD after signing in.
# Also used by `npm run create-admin` in non-interactive mode.
ADMIN_EMAIL=alisherbekboboqulov23@gmail.com
ADMIN_NAME=iafys
ADMIN_PASSWORD=Qizil!Gisht#2026
