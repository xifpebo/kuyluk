# Big Bazaar Build — environment configuration
# Copy with `npm run setup` (generates APP_SECRET) or `cp .env.example .env`.

# ---------------------------------------------------------------- server
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
# Public URL of the site. Use https:// in production (enables Secure cookies + HSTS).
APP_ORIGIN=http://localhost:5000
# Extra origins allowed to send state-changing requests (comma separated). Usually empty.
ALLOWED_ORIGINS=
# Reverse proxy: number of trusted hops (e.g. 1 behind nginx) or a list of proxy IPs.
TRUST_PROXY=
LOG_LEVEL=info

# -------------------------------------------------------------- database
MONGODB_URI=mongodb://127.0.0.1:27017/big-bazaar-build

# -------------------------------------------------------------- security
# At least 32 random characters. Signs CSRF tokens. `npm run setup` fills it in.
APP_SECRET=
# auto = Secure cookies when APP_ORIGIN is https
COOKIE_SECURE=auto
# Only for local production-mode testing over plain http. Never enable on a real server.
ALLOW_INSECURE_COOKIES=false

SESSION_IDLE_MINUTES_STAFF=30
SESSION_ABSOLUTE_HOURS_STAFF=12
SESSION_IDLE_DAYS_USER=14
SESSION_ABSOLUTE_DAYS_USER=30

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_HISTORY=5

# mongo (shared between instances) or memory (single process / tests)
RATE_LIMIT_STORE=mongo
# Ignored in production.
RATE_LIMIT_DISABLED=false

# Days to keep admin activity log entries (0 = keep forever).
AUDIT_RETENTION_DAYS=365

# --------------------------------------------------------------- content
SITE_NAME=Big Bazaar Build
SUPPORT_PHONE=+998 71 200-00-00
# uz (default) or ru
DEFAULT_LANG=uz
# google | system | local (self-hosted files in public/fonts, see public/fonts/README.md)
FONT_PROVIDER=google

UPLOAD_DIR=uploads
UPLOAD_MAX_MB=5

# Optional: notify a Telegram chat about new quote requests.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Used by `npm run create-admin` in non-interactive mode (remove after use).
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
